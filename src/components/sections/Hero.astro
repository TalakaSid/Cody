---
<section class="scene scene--hero" data-reveal>
  <div class="scene__inner">
    <span class="scene__kicker" data-reveal-text>Director &middot; Editor &middot; Motion</span>
    <h1 class="scene__title" data-reveal-text>Cody Ashworth</h1>
    <p class="scene__lede" data-reveal-text>
      Cinematic direction and post for ad agencies and production houses across India.
    </p>
  </div>
</section>

<style>
  .scene--hero {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .scene--hero .scene__inner {
    max-width: 46rem;
    padding: 0 1.5rem;
  }

  .scene__kicker {
    display: block;
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 1.5rem;
  }

  .scene__title {
    font-size: clamp(2.75rem, 8vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
    text-shadow: 0 0 40px rgba(255, 255, 255, 0.15);
  }

  .scene__lede {
    margin: 1.75rem auto 0;
    max-width: 32ch;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.75);
  }
</style>
